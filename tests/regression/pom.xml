<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>de.jflex</groupId>
    <artifactId>jflex-parent</artifactId>
    <version>1.10.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>jflex-regression-tests</artifactId>
  <name>JFlex regression tests</name>
  <description>
    End-to-end regression tests of JFlex: hand-written scanner specs with their expected output,
    as JUnit tests in src/test/java and as .test cases in src/test/cases. Not deployed.

    This module depends on jflex-test-framework, which runs jflex-maven-plugin.
    Use "mvn install", not "mvn test", from the root directory.
  </description>
  <packaging>jar</packaging>

  <properties>
    <gpg.skip>true</gpg.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <maven.site.skip>true</maven.site.skip>
    <maven.source.skip>true</maven.source.skip>
    <!-- Comma-separated case directories for TestsuiteTest, e.g. -Dtestcases=dot,testloader.
         The empty default here means all tests. -->
    <testcases></testcases>
    <generated.scanners.dir>${project.build.directory}/generated-test-sources/jflex</generated.scanners.dir>
    <work.dir>${project.build.directory}/work</work.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>de.jflex</groupId>
      <artifactId>jflex</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>de.jflex</groupId>
      <artifactId>jflex-test-framework</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.truth</groupId>
      <artifactId>truth</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- For the vendored CUP2 sources in third_party. -->
      <groupId>org.apache.ant</groupId>
      <artifactId>ant</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Hack to remove warning: This module has no main code (only tests), but the compiler warns
           if target/classes does not exist. Using an existing directory as a resource causes the
           resource plugin to create target/classes. -->
      <resource>
        <directory>src/test/java</directory>
        <excludes>
          <exclude>**</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- Scanners that tests compile against. This must be the list of specs, not their
             directories: the specs that JFlexTestRunner reads, some of which fail on purpose,
             have no place here. -->
        <groupId>de.jflex</groupId>
        <artifactId>jflex-maven-plugin</artifactId>
        <version>${project.version}</version>
        <configuration>
          <outputDirectory>${generated.scanners.dir}</outputDirectory>
        </configuration>
        <executions>
          <execution>
            <id>scanners</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <lexDefinitions>
                <lexDefinition>src/test/java/de/jflex/testcase/action_pipe/action-pipe-eof.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/action_pipe/eof-pipe-action.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/bol/bol.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/bol/bol2.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/buffer/buffer.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/caseless_jflex/caseless.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/ccl_16/ccl.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/ccl_bug/ccl-bug.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/ccl_caseless/ccl_caseless.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/ccl_esc/ccl.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/ccl_init/ccl.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/ccl_macros/cclmacros.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/ccl_neg/neg_overlap.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/ccl_pre/ccl.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/charclass/charclass.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/count/count.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/ctorarg/ctor-arg.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/ctorarg/ctor-arg-cupdebug.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/cup2private/cup2private.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/cupsym/cupsym.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/dot_newline/dotnewline.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/empty_match/emptymatch.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/eof/eof.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/eof_min/eofmin.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/eofclose/eofclose.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/eofclose/eofnoclose.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/eol_comment/eolcomment.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/eol_look/eol.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/fixed_look/fixedlook.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/generics/generics.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/generics/generics2.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/generics/generics3.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/generics/generics4.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/genlook/genlook.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/genlook2/genlook2.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/include_in_rules/IncludeInRules.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/initthrow_eol/initthrow.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/large_input/large_input.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/large_table/large.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/look/look.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/look_macro/lookmacro.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/macro_exp/macro.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/negation/negation.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/sevenbit/sevenbit.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/spoon_feed_reader/SpoonFeedReader.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/token_limit/limit_success.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/unicode_escape_warning/warnings.flex</lexDefinition>
                <lexDefinition>src/test/java/de/jflex/testcase/yylexthrow_comment/yylexthrow.flex</lexDefinition>
              </lexDefinitions>
            </configuration>
          </execution>
          <execution>
            <id>scanner-caseless_jlex-caseless</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <jlex>true</jlex>
              <lexDefinitions>
                <lexDefinition>src/test/java/de/jflex/testcase/caseless_jlex/caseless.flex</lexDefinition>
              </lexDefinitions>
            </configuration>
          </execution>
          <execution>
            <id>scanner-include-include</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <skeleton>src/test/java/de/jflex/testcase/include/skeleton.nested</skeleton>
              <lexDefinitions>
                <lexDefinition>src/test/java/de/jflex/testcase/include/include.flex</lexDefinition>
              </lexDefinitions>
            </configuration>
          </execution>
          <execution>
            <id>scanner-include2-include2</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <skeleton>src/test/java/de/jflex/testcase/include2/skeleton.nested</skeleton>
              <lexDefinitions>
                <lexDefinition>src/test/java/de/jflex/testcase/include2/include2.flex</lexDefinition>
              </lexDefinitions>
            </configuration>
          </execution>
          <execution>
            <id>scanner-spoon_feed_reader-SpoonFeedReaderF</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <skeleton>src/test/java/de/jflex/testcase/spoon_feed_reader/problematic.skeleton.default</skeleton>
              <lexDefinitions>
                <lexDefinition>src/test/java/de/jflex/testcase/spoon_feed_reader/SpoonFeedReaderF.flex</lexDefinition>
              </lexDefinitions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- jflex-maven-plugin adds its output to the main sources, which are compiled by now. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${generated.scanners.dir}</source>
                <source>third_party/cup2</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <testExcludes>
            <!-- Input of ApiPrivateTest, which checks that this does not compile. -->
            <testExclude>de/jflex/testcase/apipirivate/AttemptPrivateAccess.java</testExclude>
          </testExcludes>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- This module only has tests. -->
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
      <plugin>
        <!-- fmt-maven-plugin warns when the main source directory is missing. Give it an existing
             directory without Java files instead. -->
        <groupId>com.spotify.fmt</groupId>
        <artifactId>fmt-maven-plugin</artifactId>
        <configuration>
          <sourceDirectory>${project.basedir}/src/test/cases</sourceDirectory>
        </configuration>
      </plugin>
      <plugin>
        <!-- Tests must start without the output of the last run, or JFlex reports that it saved
             the old file, which is not in the goldens. -->
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>clean-work-dir</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${work.dir}</directory>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <!-- Tests read their specs, inputs and goldens with paths relative to this directory,
                 and JFlex writes next to the spec. Run them in a copy of those files, so that
                 what they generate stays in target. -->
            <id>copy-work-dir</id>
            <phase>process-test-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${work.dir}</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/src/test/java</directory>
                  <targetPath>src/test/java</targetPath>
                  <excludes>
                    <exclude>**/*.java</exclude>
                  </excludes>
                </resource>
                <resource>
                  <directory>${project.basedir}/src/test/java</directory>
                  <targetPath>src/test/java</targetPath>
                  <includes>
                    <include>de/jflex/testcase/apipirivate/AttemptPrivateAccess.java</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <workingDirectory>${work.dir}</workingDirectory>
          <systemPropertyVariables>
            <jflex.testsuite.dir>${project.basedir}</jflex.testsuite.dir>
            <jflex.testsuite.out>${project.build.directory}/testsuite</jflex.testsuite.out>
            <jflex.testsuite.cases>${testcases}</jflex.testsuite.cases>
          </systemPropertyVariables>
          <!-- The defaults would miss the numbered classes, e.g. NoWarnTest1. -->
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Test?.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
