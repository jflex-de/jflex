<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>de.jflex</groupId>
    <artifactId>jflex-parent</artifactId>
    <version>1.10.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>jflex-dev-tests</artifactId>
  <name>JFlex development tests</name>
  <description>
    Tests for the JFlex development tools. Not deployed.

    This module depends on the jflex-dev-tools module, which runs jflex-maven-plugin.
    Use "mvn install", not "mvn test", from the root directory.
  </description>
  <packaging>jar</packaging>

  <properties>
    <gpg.skip>true</gpg.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <maven.site.skip>true</maven.site.skip>
    <maven.source.skip>true</maven.source.skip>
    <ucd.dir>${project.build.directory}/ucd</ucd.dir>
    <ucd.url>https://www.unicode.org/Public</ucd.url>
    <work.dir>${project.build.directory}/javatests-work</work.dir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>de.jflex</groupId>
      <artifactId>jflex</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>de.jflex</groupId>
      <artifactId>jflex-dev-tools</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.auto.value</groupId>
      <artifactId>auto-value-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.truth</groupId>
      <artifactId>truth</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.velocity</groupId>
      <artifactId>velocity</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <testSourceDirectory>${project.basedir}</testSourceDirectory>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <testIncludes>
            <testInclude>de/jflex/migration/**/*.java</testInclude>
            <testInclude>de/jflex/testing/**/*.java</testInclude>
            <testInclude>de/jflex/ucd/**/*.java</testInclude>
            <testInclude>de/jflex/ucd_generator/**/*.java</testInclude>
            <testInclude>de/jflex/util/**/*.java</testInclude>
            <testInclude>de/jflex/velocity/**/*.java</testInclude>
            <testInclude>de/jflex/version/**/*.java</testInclude>
          </testIncludes>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- This module only has tests. -->
          <skipIfEmpty>true</skipIfEmpty>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <!-- Tests use paths relative to the repository root: goldens and test inputs.
                 Run them in a copy of those files, so that what they generate stays in target.
                 This must not include BUILD.bazel, or Bazel would see the copies. -->
            <id>copy-work-dir</id>
            <phase>process-test-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${work.dir}</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}</directory>
                  <targetPath>javatests</targetPath>
                  <includes>
                    <include>de/**</include>
                    <include>jflex/**</include>
                  </includes>
                  <excludes>
                    <exclude>**/*.java</exclude>
                    <exclude>**/BUILD.bazel</exclude>
                  </excludes>
                </resource>
                <resource>
                  <directory>${project.basedir}/../testsuite/testcases/src/test/resources</directory>
                  <targetPath>testsuite/testcases/src/test/resources</targetPath>
                  <includes>
                    <include>*.input</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <workingDirectory>${work.dir}</workingDirectory>
          <systemPropertyVariables>
            <jflex.ucd.dir>${ucd.dir}</jflex.ucd.dir>
          </systemPropertyVariables>
          <!-- The defaults would miss the Test_x_y classes. -->
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Test_*.java</include>
            <include>**/*Tests.java</include>
            <include>**/*Quickcheck.java</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <!-- Unicode Character Database files, read through de.jflex.ucd.UcdFiles.

